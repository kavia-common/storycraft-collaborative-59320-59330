# Example environment configuration for Story Frontend
# Copy to .env and adjust values for your environment.

# REST API base. Use a relative prefix if backend is on same origin (recommended in local/dev):
# e.g., /api or /api/v1
# Or provide a full URL if the backend is hosted elsewhere:
# e.g., https://backend.example.com/api
REACT_APP_API_BASE=/api

# Socket.IO server URL. Can be empty to use same origin, or a full URL.
# e.g., https://backend.example.com
REACT_APP_SOCKET_URL=

# Site URL for auth email redirects (used by backend integrations that require it).
REACT_APP_SITE_URL=http://localhost:3000
